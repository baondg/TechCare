          "sex": "M",
          "tel": "090",
          "email": "b@x.vn",
          "idcard": "<idcard>"
        }
      },
      {
        "event": "Patient.findOne",
        "where": {
          "user_id": 70
        },
        "tx": "tx1"
      },
      {
        "event": "Relative.destroy",
        "where": {
          "patient_id": 7
        },
        "tx": "tx1"
      },
      {
        "event": "Relative.create",
        "values": {
          "patient_id": 7,
          "name": "Lan",
          "relationship": "Mother",
          "dob": null,
          "sex": "F",
          "tel": null,
          "email": "lan@x.vn",
          "idcard": "<idcard>"
        },
        "tx": "tx1"
      },
      {
        "event": "commit",
        "tx": "tx1"
      }
    ]
  },
