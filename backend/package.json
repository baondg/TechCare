{
  "name": "techcare-backend",
  "version": "1.0.0",
  "description": "Backend API for TechCare application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage test/*.test.js",
    "lint": "eslint src test scripts",
    "clean": "rimraf dist",
    "create-admin": "node scripts/create-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:reset": "node scripts/seed-demo.js --reset-demo-only",
    "seed:demo:fullreset": "node scripts/seed-demo.js --purge-all",
    "seed:patient:vitals-slots": "node scripts/seed-patient-vitals-and-slots.js",
    "seed:work-shifts:jun-2026": "node scripts/seed-work-shifts-jun-2026.js",
    "db:backup": "node scripts/backup-restore.js backup",
    "db:restore": "node scripts/backup-restore.js restore",
    "db:indexes": "node scripts/ensure-performance-indexes.js",
    "migrate:system-config-kv": "node scripts/migrate-system-configuration-to-kv.js",
    "db:migrate:system-config": "node scripts/migrate-system-configuration-to-kv.js",
    "db:ensure-columns": "node scripts/ensure-schema-columns.js",
    "db:flag-shared-passwords": "node scripts/flag-shared-passwords.js",
    "normalize-js-utf8": "node scripts/normalize-js-utf8.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^5.12.1",
    "sequelize": "^6.37.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "globals": "^17.13.0",
    "rimraf": "^5.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "keywords": [
    "techcare",
    "healthcare",
    "api",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT"
}
