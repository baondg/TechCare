# AI Service Configuration
# Replace with your actual API endpoint and key

# VITE_AI_PROVIDER options:
# - custom: Your own backend API (default)
# - openai: OpenAI GPT models
# - anthropic or claude: Anthropic Claude models
# - cohere: Cohere AI models
# - huggingface: Hugging Face models
# - gemini: Google Gemini models
# - azure-openai: Azure OpenAI Service

VITE_AI_PROVIDER=openai

# OpenRouter API (uses OpenAI-compatible format)
VITE_AI_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
VITE_AI_API_KEY=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

# Option 2: OpenAI API
# VITE_AI_PROVIDER=openai
# VITE_AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=sk-your-openai-api-key

# Option 3: Anthropic Claude API
# VITE_AI_PROVIDER=anthropic
# VITE_AI_API_ENDPOINT=https://api.anthropic.com/v1/messages
# VITE_AI_API_KEY=sk-ant-your-anthropic-key

# Option 4: Cohere API
# VITE_AI_PROVIDER=cohere
# VITE_AI_API_ENDPOINT=https://api.cohere.ai/v1/chat
# VITE_AI_API_KEY=your-cohere-api-key

# Option 5: Hugging Face API
# VITE_AI_PROVIDER=huggingface
# VITE_AI_API_ENDPOINT=https://api-inference.huggingface.co/models/meta-llama/Llama-2-70b-chat-hf
# VITE_AI_API_KEY=hf_your-huggingface-token

# Option 6: Google Gemini API
# VITE_AI_PROVIDER=gemini
# VITE_AI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1/models/gemini-pro:generateContent?key=YOUR_API_KEY
# VITE_AI_API_KEY=your-gemini-api-key

# Option 7: Azure OpenAI
# VITE_AI_PROVIDER=azure-openai
# VITE_AI_API_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2023-05-15
# VITE_AI_API_KEY=your-azure-api-key

# Option 8: ANY other AI service
# Just set VITE_AI_PROVIDER=custom and provide your endpoint + key
# The system will try to parse common response formats automatically

# Other Configuration
VITE_BACKEND_URL=http://localhost:3000
