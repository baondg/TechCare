NODE_ENV=production
PORT=8080
DB_NAME=techcare
DB_USER=techcare
DB_PASSWORD=REPLACE_ME
DB_POOL_MAX=40
DB_POOL_MIN=5
DB_POOL_ACQUIRE_MS=60000
DB_POOL_IDLE_MS=10000
CLOUDSQL_INSTANCE_CONNECTION_NAME=PROJECT_ID:REGION:techcare-mysql
REDIS_URL=redis://10.0.0.5:6379
ENABLE_PATIENT_RECORD_CACHE=1
ENABLE_DISTRIBUTED_RATE_LIMIT=1
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET
BENCHMARK_RATE_LIMIT_BYPASS=0
INTERNAL_API_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
# Initial password of admin-created accounts (not Test@1234; account creation is refused without it).
DEFAULT_ACCOUNT_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
AUTO_SYNC_DB=0
CORS_ALLOWED_ORIGINS=https://app.example.com
