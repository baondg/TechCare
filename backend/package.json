{
  "name": "techcare-backend",
  "version": "1.0.0",
  "description": "Backend API for TechCare application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "create-admin": "node scripts/create-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:reset": "node scripts/seed-demo.js --reset-demo-only",
    "seed:demo:fullreset": "node scripts/seed-demo.js --purge-all",
    "seed:patient:vitals-slots": "node scripts/seed-patient-vitals-and-slots.js",
    "db:backup": "node scripts/backup-restore.js backup",
    "db:restore": "node scripts/backup-restore.js restore",
    "db:indexes": "node scripts/ensure-performance-indexes.js",
    "migrate:system-config-kv": "node scripts/migrate-system-configuration-to-kv.js",
    "db:migrate:system-config": "node scripts/migrate-system-configuration-to-kv.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3",
    "openai": "^6.10.0",
    "redis": "^5.12.1",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "rimraf": "^5.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "keywords": [
    "techcare",
    "healthcare",
    "api",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT"
}
